{
  "redirects": [
    { "source": "/blog.dc.html", "destination": "/", "permanent": true },
    { "source": "/portfolio.dc.html", "destination": "/projects", "permanent": true },
    { "source": "/project-detail.dc.html", "destination": "/project-detail", "permanent": true },
    { "source": "/single-post.dc.html", "destination": "/", "permanent": true },

    { "source": "/blog", "destination": "/", "permanent": true },
    { "source": "/portfolio", "destination": "/projects", "permanent": true },
    { "source": "/single-post", "destination": "/", "permanent": true },

    { "source": "/en/blog", "destination": "/", "permanent": true },
    { "source": "/ar/blog", "destination": "/", "permanent": true },
    { "source": "/en/portfolio", "destination": "/projects", "permanent": true },
    { "source": "/ar/portfolio", "destination": "/ar", "permanent": true },
    { "source": "/ar/projects", "destination": "/ar", "permanent": true },
    { "source": "/en/project-detail", "destination": "/", "permanent": true },
    { "source": "/ar/project-detail", "destination": "/", "permanent": true },
    { "source": "/en/single-post", "destination": "/", "permanent": true },
    { "source": "/ar/single-post", "destination": "/", "permanent": true },

    { "source": "/contact.dc.html", "destination": "/contact", "permanent": true },
    { "source": "/home.ar.dc.html", "destination": "/ar", "permanent": true },
    { "source": "/contact.ar.dc.html", "destination": "/ar/contact", "permanent": true },

    { "source": "/home.dc.html", "destination": "/", "permanent": true },
    { "source": "/about-us.dc.html", "destination": "/about-us", "permanent": true },
    { "source": "/about-us.ar.dc.html", "destination": "/ar/about-us", "permanent": true },
    { "source": "/about-us-2.dc.html", "destination": "/about-us-2", "permanent": true },
    { "source": "/projects.dc.html", "destination": "/projects", "permanent": true },
    { "source": "/services.dc.html", "destination": "/services", "permanent": true },
    { "source": "/services.ar.dc.html", "destination": "/ar/services", "permanent": true },
    { "source": "/services-interior-design.dc.html", "destination": "/services-interior-design", "permanent": true },
    { "source": "/services-interior-design.ar.dc.html", "destination": "/ar/services-interior-design", "permanent": true },
    { "source": "/services-fitout.dc.html", "destination": "/services-fitout", "permanent": true },
    { "source": "/services-fitout.ar.dc.html", "destination": "/ar/services-fitout", "permanent": true },
    { "source": "/services-mep.dc.html", "destination": "/services-mep", "permanent": true },
    { "source": "/services-mep.ar.dc.html", "destination": "/ar/services-mep", "permanent": true },
    { "source": "/services-furniture.dc.html", "destination": "/services-furniture", "permanent": true },
    { "source": "/services-furniture.ar.dc.html", "destination": "/ar/services-furniture", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/uploads/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/_ds/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/support.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
    },
    {
      "source": "/nav-mobile.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
    },
    {
      "source": "/floating-buttons.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
    },
    {
      "source": "/analytics-events.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/Furnishiq.net/home.dc.html" },
    { "source": "/en", "destination": "/Furnishiq.net/home.dc.html" },
    { "source": "/en/contact", "destination": "/Furnishiq.net/contact.dc.html" },
    { "source": "/ar", "destination": "/Furnishiq.net/home.ar.dc.html" },
    { "source": "/ar/contact", "destination": "/Furnishiq.net/contact.ar.dc.html" },
    { "source": "/ar/about-us", "destination": "/Furnishiq.net/about-us.ar.dc.html" },
    { "source": "/ar/services", "destination": "/Furnishiq.net/services.ar.dc.html" },
    { "source": "/ar/services-interior-design", "destination": "/Furnishiq.net/services-interior-design.ar.dc.html" },
    { "source": "/ar/services-fitout", "destination": "/Furnishiq.net/services-fitout.ar.dc.html" },
    { "source": "/ar/services-mep", "destination": "/Furnishiq.net/services-mep.ar.dc.html" },
    { "source": "/ar/services-furniture", "destination": "/Furnishiq.net/services-furniture.ar.dc.html" },
    { "source": "/en/:path*", "destination": "/Furnishiq.net/:path*" },
    { "source": "/ar/:path*", "destination": "/Furnishiq.net/:path*" },
    { "source": "/contact", "destination": "/Furnishiq.net/contact.dc.html" },
    { "source": "/about-us", "destination": "/Furnishiq.net/about-us.dc.html" },
    { "source": "/about-us-2", "destination": "/Furnishiq.net/about-us-2.dc.html" },
    { "source": "/blog", "destination": "/Furnishiq.net/blog.dc.html" },
    { "source": "/services", "destination": "/Furnishiq.net/services.dc.html" },
    { "source": "/projects", "destination": "/Furnishiq.net/projects.dc.html" },
    { "source": "/project-detail", "destination": "/Furnishiq.net/project-detail.dc.html" },
    { "source": "/single-post", "destination": "/Furnishiq.net/single-post.dc.html" },
    { "source": "/services-interior-design", "destination": "/Furnishiq.net/services-interior-design.dc.html" },
    { "source": "/services-fitout", "destination": "/Furnishiq.net/services-fitout.dc.html" },
    { "source": "/services-mep", "destination": "/Furnishiq.net/services-mep.dc.html" },
    { "source": "/services-furniture", "destination": "/Furnishiq.net/services-furniture.dc.html" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/:path*", "destination": "/Furnishiq.net/:path*" }
  ]
}
